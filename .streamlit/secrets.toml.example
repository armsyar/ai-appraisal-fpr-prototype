# Copy this file to .streamlit/secrets.toml for LOCAL testing,
# or paste its contents into the "Secrets" box in Streamlit Community Cloud
# (App settings -> Secrets) for the deployed app.
#
# NEVER commit a real .streamlit/secrets.toml file to GitHub.
# This example file contains no real credentials and is safe to commit.

# --- Anthropic API key -----------------------------------------------------
# One shared key, paid by the researcher, used for every participant's
# AI-Assisted generations. Participants never see this value.
ANTHROPIC_API_KEY = "sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# --- Google Sheets storage --------------------------------------------------
# The ID from your Google Sheet's URL:
# https://docs.google.com/spreadsheets/d/THIS_LONG_ID_HERE/edit
sheet_id = "your-google-sheet-id-here"

# Paste the full JSON key file you downloaded for your Google Cloud
# service account, as a TOML table (each field on its own line, no
# surrounding braces). Keep "private_key" exactly as downloaded, including
# the \n characters and the BEGIN/END lines.
[gcp_service_account]
type = "service_account"
project_id = "your-gcp-project-id"
private_key_id = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
private_key = "-----BEGIN PRIVATE KEY-----\nMIIExampleKeyContentGoesHere\n-----END PRIVATE KEY-----\n"
client_email = "your-service-account@your-gcp-project-id.iam.gserviceaccount.com"
client_id = "123456789012345678901"
token_uri = "https://oauth2.googleapis.com/token"
